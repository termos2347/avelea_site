# Скопируйте в .env:  cp .env.example .env

# --- Секреты (обязательно) ---
# SECRET_KEY — минимум 32 символа.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# ADMIN_PASSWORD — минимум 12 символов.
SECRET_KEY=change-me
ADMIN_PASSWORD=change-me

# --- БД ---
# Облачный Postgres. Суффикс "+psycopg" ОБЯЗАТЕЛЕН — без него SQLAlchemy
# попытается импортировать psycopg2, которого нет в requirements.txt.
#   postgresql+psycopg://user:pass@host:5432/dbname
#   postgresql+psycopg://user:pass@host/dbname?sslmode=require
DATABASE_URL=

# --- Telegram 2FA ---
#   не задан / пуст  → авто: включено, если BOT_TOKEN и ADMIN_ID заполнены,
#                      иначе выключено
#   1                → включено (пустые BOT_TOKEN/ADMIN_ID → не запустится)
#   0                → выключено
TELEGRAM_2FA_ENABLED=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=
TELEGRAM_CODE_TTL=180
TELEGRAM_CODE_MAX_ATTEMPTS=5

# --- Uvicorn ---
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000
UVICORN_RELOAD=1        # dev: 1, prod: 0
UVICORN_WORKERS=1       # НЕ увеличивать без Redis (см. README)

# --- Сессия / cookies ---
SESSION_HTTPS_ONLY=0    # dev: 0, prod (https): 1
SESSION_SAME_SITE=lax
SESSION_MAX_AGE=1209600

# --- Загрузки ---
MAX_UPLOAD_MB=5
MAX_VIDEO_UPLOAD_MB=80
MAX_IMAGE_DIMENSION=1200

# --- Seed ---
# 0 — только базовые категории и бренд Avelea (боевой режим)
# 1 — плюс демо-товар (для тестов и локальной отладки)
SEED_DEMO_PRODUCT=0

# --- Хранилище картинок ---
STORAGE_BACKEND=local   # "local" или "s3"
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=