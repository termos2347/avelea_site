# Скопируйте в .env:  cp .env.example .env

# --- Секреты (обязательно) ---
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
ADMIN_PASSWORD=change-me

# --- БД (пусто = sqlite:///<проект>/instance/shop.db) ---
DATABASE_URL=sqlite:///instance/shop.db

# --- Uvicorn ---
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000
# dev: 1, prod: 0
UVICORN_RELOAD=1
UVICORN_WORKERS=1

# --- Сессия / cookies ---
# dev (http://):  0
# prod (https://): 1
SESSION_HTTPS_ONLY=0
SESSION_SAME_SITE=lax
SESSION_MAX_AGE=1209600

# --- Загрузки ---
MAX_UPLOAD_MB=5

# --- Хранилище картинок ---
# "local" — папка static/uploads (по умолчанию)
# "s3"    — S3-совместимое хранилище (Cloudflare R2, Selectel, VK Cloud)
STORAGE_BACKEND=local

# Заполнять ТОЛЬКО если STORAGE_BACKEND=s3
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=